# ============================================================
# MandiSaarthi — root .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ----- Secrets (NEVER commit) --------------------------------
backend/.env
frontend/.env
.env
.env.*
!.env.example
backend/.env.*
!backend/.env.example
frontend/.env.*
!frontend/.env.example

# ----- Raw / unprocessed data (too large, not curated) ------
backend/data/raw/

# ----- Node / frontend --------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/

# ----- OS artefacts -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE --------------------------------------------------
.vscode/settings.json
.idea/
*.suo
*.user

# ----- Misc -------------------------------------------------
*.bak
*.swp
*.tmp
