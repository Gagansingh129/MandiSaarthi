# ============================================================
# MandiSaarthi Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# Official data.gov.in API key (optional — app works offline using bundled snapshot)
# Get yours at: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Legacy alias (also recognized if DATA_GOV_IN_API_KEY is not set)
# AGMARKNET_API_KEY=your_api_key_here

# Official Agmarknet Current Daily Price resource identifier on data.gov.in
# Dataset page: https://www.data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Set to "true" to force CSV snapshot mode even if API key is present
FORCE_CSV_MODE=false

# Timeouts & Retries
API_CONNECT_TIMEOUT=5.0
API_READ_TIMEOUT=15.0
API_MAX_RETRIES=3
CACHE_TTL_SECONDS=600

# CORS — comma-separated origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
